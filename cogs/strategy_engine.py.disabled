logger = logging.getLogger(__name__)

OWO_BOT_ID = 408785106942164992


# False positive tier names misparsed from help or summary embeds
TIER_FILTER_NAMES: set[str] = {
    "common", "uncommon", "rare", "epic", "mythic", "mythical",
    "legendary", "fabled", "special", "gem", "hidden", "patreon", "distorted",
    "c", "u", "r", "e", "m", "l", "f", "g", "b", "s", "h", "d", "p",
    "hp", "wp", "str", "mag", "pr", "mr", "health", "mana", "points",
    "stat", "stats", "weapon", "weapons", "animal", "animals", "level",
    "lvl", "xp", "exp", "total", "score", "rank", "tier"
}

# Discord commands or help keywords mistakenly parsed as weapon IDs
DISCORD_HELP_KEYWORDS: set[str] = {
    "cookie", "cuddle", "rada", "proxies", "settings", "profile", "marry", "emoji",
    "wallpaper", "owoify", "avatar", "hug", "kiss", "lick", "nom", "pat", "poke",
    "slap", "stare", "highfive", "bite", "greet", "punch", "handholding", "tickle",
    "kill", "hold", "pats", "wave", "boop", "snuggle", "bully", "pray", "curse",
    "ship", "level", "quest", "checklist", "use", "inv", "sell", "crate", "lootbox",
    "battle", "hunt", "shop", "daily", "cf", "slots", "bj", "blackjack", "autohunt",
    "upgrade", "sacrifice", "team", "zoo", "run", "pup", "piku"
}

# Default placeholder weapon IDs used for initialization before live telemetry
FALLBACK_WEAPON_IDS: set[str] = {
    "101", "102", "103", "104", "105", "106", "107", "108",
    "201", "202", "203", "b204", "W1", "W2", "W3"
}

try:
    from owo_strategy.ingestion.catalog_sync import load_catalog_animals
    ANIMAL_CATALOG: set[str] = {a.name.lower() for a in load_catalog_animals()}
except Exception:
    ANIMAL_CATALOG: set[str] = set()

try:
    ANIMAL_CATALOG.update(STANDARD_ANIMAL_NAMES)
except Exception:
    pass

try:
    ANIMAL_CATALOG.update(KNOWN_ANIMAL_DEX.keys())
except Exception:
    pass


def is_valid_animal(a: Any) -> bool:
    """Validate that an animal is a legitimate OwO animal and not a tier name or help string."""
    name = getattr(a, "name", None) or (a.get("name") if isinstance(a, Mapping) else str(a))
    if not name:
        return False
    clean = str(name).strip().lower()
    if clean in TIER_FILTER_NAMES:
        return False
    if clean in ANIMAL_CATALOG:
        return True
    norm = normalize_animal_name(clean)
    if norm in ANIMAL_CATALOG and norm not in TIER_FILTER_NAMES:
        return True
    if getattr(a, "level", 0) > 0 and clean not in TIER_FILTER_NAMES and len(clean) >= 3:
        return True
    return False


def is_valid_weapon(w: Any) -> bool:
    """Validate that a weapon is legitimate and not a misparsed discord command keyword."""
    w_id = getattr(w, "id", None) or (w.get("id") if isinstance(w, Mapping) else None)
    if not w_id:
        return True
    clean_id = str(w_id).strip().lower()
    if clean_id in DISCORD_HELP_KEYWORDS:
        return False
    w_name = getattr(w, "weapon_name", None) or (w.get("weapon_name") if isinstance(w, Mapping) else None)
    if (w_name or "").lower() == "unknown weapon" and clean_id in DISCORD_HELP_KEYWORDS:
        return False
    return True


class StrategyEngine(commands.Cog):
    """OwO Strategy Engine & Tactical Optimizer Cog."""

    def __init__(self, bot: commands.Bot, uid: Optional[str] = None) -> None:
        self.bot = bot
        base_dir = getattr(bot, "base_dir", os.getcwd())

        # Determine account identifier
        uid_val = uid or getattr(bot, "user_id", None) or (bot.user.id if getattr(bot, "user", None) else None)
        account_id = str(uid_val) if uid_val is not None else None
        if not account_id or account_id == "None":
            token = getattr(bot, "token", None) or getattr(bot, "_token", None)
            accounts_file = os.path.join(base_dir, "config", "accounts.json")
            if token and os.path.exists(accounts_file):
                try:
                    with open(accounts_file, "r", encoding="utf-8") as f:
                        acc_data = json.load(f)
                    for acc in acc_data.get("accounts", []):
                        if acc.get("token") == token:
                            if acc.get("user_id"):
                                account_id = str(acc["user_id"])
                                break
                            elif acc.get("id"):
                                account_id = str(acc["id"])
                                break
                            elif acc.get("name"):
                                account_id = str(acc["name"])
                                break
                    if not account_id or account_id == "None":
                        import base64
                        part = token.split(".")[0]
                        padding = "=" * ((4 - len(part) % 4) % 4)
                        decoded = base64.b64decode(part + padding).decode("utf-8", errors="ignore")
                        if decoded.isdigit():
                            account_id = decoded
                except Exception:
                    pass
        if not account_id or account_id == "None":
            account_id = "default"

        self.uid = account_id
        self.account_id = account_id
        self.state_file = os.path.join(base_dir, "data", f"strategy_state_{account_id}.json")

        cfg = getattr(bot, "config", {}).get("strategy", {}) if hasattr(bot, "config") and isinstance(bot.config, dict) else {}
        self.enabled = bool(cfg.get("enabled", True))
        self.interval = cfg.get("interval", [3600, 7200])
        self.auto_equip = bool(cfg.get("auto_equip", True))
        self.auto_dismantle = bool(cfg.get("auto_dismantle", False))
        self.dry_run = bool(cfg.get("dry_run", True if not cfg else False))
        self.dismantle_quality_threshold = float(cfg.get("dismantle_quality_threshold", 40.0))
        self.protect_quality_threshold = float(cfg.get("protect_quality_threshold", 80.0))
        self.boss_raid_solver = bool(cfg.get("boss_raid_solver", True))
        self.owo_bot_id = str(getattr(bot, "owo_bot_id", OWO_BOT_ID))
        self.team_verified_from_owo = False
        self.pending_equip: Optional[dict[str, Any]] = None
        self._lock: Optional[asyncio.Lock] = None
        self._latest_opt_winner: Optional[CandidateTeam] = None

        # Telemetry duplicate log trackers
        self._last_active_team_sig: Optional[tuple] = None
        self._last_weapon_page_seen: Optional[tuple] = None
        self._last_zoo_count: int = -1
        self._last_neon_calc_msg_id: Optional[int | str] = None

        self._load_state()
        if self.current_team_animals:
            self._last_active_team_sig = tuple(
                (a.name.lower(), getattr(a, "equipped_weapon_id", None))
                for a in self.current_team_animals
            )

    @property
    def lock(self) -> asyncio.Lock:
        if getattr(self, "_lock", None) is None:
            self._lock = asyncio.Lock()
        return self._lock

    def sanitize_inventories(self) -> None:
        """Filter out false positive tier names from animals and command keywords from weapons."""
        self.inventory_animals = [a for a in self.inventory_animals if is_valid_animal(a)]
        self.current_team_animals = [a for a in self.current_team_animals if is_valid_animal(a)]
        self.inventory_weapons = [w for w in self.inventory_weapons if is_valid_weapon(w)]
        self.current_team_weapons = [w for w in self.current_team_weapons if is_valid_weapon(w)]

    _sanitize_inventories = sanitize_inventories

    def _load_state(self) -> None:
        """Load cached team, inventory snapshot, and settings from JSON."""
        os.makedirs(os.path.dirname(self.state_file), exist_ok=True)
        self.current_team_animals: list[OwnedAnimal] = []
        self.current_team_weapons: list[OwnedWeapon] = []
        self.inventory_animals: list[OwnedAnimal] = []
        self.inventory_weapons: list[OwnedWeapon] = []
        self.current_shards: int = 650
        self.last_updated: float = 0.0
        self.lineup_history: list[dict[str, Any]] = []

        base_dir = getattr(self.bot, "base_dir", os.getcwd())
        seed_file = os.path.join(base_dir, "data", "strategy_state.json")
        target_file = self.state_file
        file_to_load = None
        if os.path.exists(target_file):
            file_to_load = target_file
        elif os.path.exists(seed_file):
            file_to_load = seed_file

        if file_to_load and os.path.exists(file_to_load):
            try:
                with open(file_to_load, "r", encoding="utf-8") as f:
                    data = json.load(f)
                team_data = data.get("team", {})
                self.current_team_animals = [
                    OwnedAnimal.from_dict(item) if isinstance(item, dict) else item
                    for item in team_data.get("animals", [])
                ]
                self.current_team_weapons = [
                    OwnedWeapon.from_dict(item) if isinstance(item, dict) else item
                    for item in team_data.get("weapons", [])
                ]
                self.inventory_animals = [
                    OwnedAnimal.from_dict(item) if isinstance(item, dict) else item
                    for item in data.get("inventory_animals", [])
                ]
                self.inventory_weapons = [
                    OwnedWeapon.from_dict(item) if isinstance(item, dict) else item
                    for item in data.get("inventory_weapons", [])
                ]
                self.current_shards = int(data.get("current_shards", 650))
                self.last_updated = float(data.get("last_updated", 0.0))
                self.team_verified_from_owo = bool(data.get("team_verified", False))
                self.lineup_history = list(data.get("lineup_history", []))
            except Exception as exc:
                logger.warning("Error reading strategy state from %s: %s", file_to_load, exc)

        self.sanitize_inventories()

        # Populate safe fallback defaults if state was empty
        if not self.current_team_animals or not self.current_team_weapons:
            self._init_default_fallback()

